// ═══════════════════════════════════════════════════════════════
// MANARA OS — COMPLETE POSTGRESQL PRISMA SCHEMA v3.0
// Multi-tenant Property Management Operating System — UAE Edition
// ═══════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp"), pg_trgm, unaccent]
}

