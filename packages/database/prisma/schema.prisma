// ─────────────────────────────────────────────────────────────
// CORE MULTI-TENANT: WORKSPACES
// ─────────────────────────────────────────────────────────────

model Workspace {
  id                String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String           @db.VarChar(255)
  slug              String           @unique @db.VarChar(100)
  logoUrl           String?          @map("logo_url")
  primaryColor      String?          @default("#10B981") @map("primary_color") @db.VarChar(7)
  countryCode       CountryCode      @default(AE) @map("country_code")
  currencyCode      String           @default("AED") @map("currency_code") @db.Char(3)
  vatRate           Decimal          @default(5.00) @map("vat_rate") @db.Decimal(5, 2)
  gstRate           Decimal?         @map("gst_rate") @db.Decimal(5, 2)
  ejariEnabled      Boolean          @default(false) @map("ejari_enabled")
  reraCode          String?          @map("rera_code") @db.VarChar(50)
  trnNumber         String?          @map("trn_number") @db.VarChar(30)
  tradeLicenseNo    String?          @map("trade_license_no") @db.VarChar(50)
  subscriptionPlan  SubscriptionPlan @default(STARTER) @map("subscription_plan")
  status            WorkspaceStatus  @default(TRIAL)
  trialEndsAt       DateTime?        @map("trial_ends_at") @db.Timestamptz
  stripeCustomerId  String?          @map("stripe_customer_id")
  stripeSubId       String?          @map("stripe_sub_id")
  billingEmail      String?          @map("billing_email")
  timezone          String           @default("Asia/Dubai")
  locale            String           @default("en")
  dateFormat        String           @default("DD/MM/YYYY") @map("date_format")
  maxProperties     Int              @default(10) @map("max_properties")
  maxUsers          Int              @default(5) @map("max_users")
  features          Json             @default("{}") @db.JsonB
  countryConfig     Json             @default("{}") @map("country_config") @db.JsonB
  contactPhone      String?          @map("contact_phone") @db.VarChar(20)
  contactEmail      String?          @map("contact_email")
  address           String?
  city              String?          @db.VarChar(100)
  isWhiteLabel      Boolean          @default(false) @map("is_white_label")
  customDomain      String?          @unique @map("custom_domain")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz

  // Relations
  users             WorkspaceUser[]
  properties        Property[]
  units             Unit[]
  owners            Owner[]
  tenants           Tenant[]
  vendors           Vendor[]
  leases            Lease[]
  tickets           Ticket[]
  documents         Document[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  rentCollections   RentCollection[]
  expenses          Expense[]
  pdcCheques        PdcCheque[]
  subscriptionInvoices SubscriptionInvoice[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  propertyListings  PropertyListing[]
  commissions       Commission[]
  renewalAlerts     RenewalAlert[]
  complianceItems   ComplianceItem[]
  receipts          Receipt[]
  taxCertificates   TaxCertificate[]
  reviews           Review[]
  npsResponses      NpsResponse[]
  ticketBids        TicketBid[]
  vendorScores     VendorScore[]
  aecbReports       AecbReport[]
  whatsappMessages  WhatsAppMessage[]
  renovationScenarios RenovationScenario[]

  @@index([slug])
  @@index([status])
  @@map("workspaces")
}

// ─────────────────────────────────────────────────────────────
// USERS & WORKSPACE MEMBERSHIP
// ─────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone            String    @unique @db.VarChar(20)
  email            String?   @unique @db.VarChar(255)
  fullName         String?   @map("full_name") @db.VarChar(255)
  avatarUrl        String?   @map("avatar_url")
  isActive         Boolean   @default(true) @map("is_active")
  emailVerified    Boolean   @default(false) @map("email_verified")
  phoneVerified    Boolean   @default(true) @map("phone_verified")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  workspaceUsers   WorkspaceUser[]
  pushTokens       PushToken[]
  otpCodes         OtpCode[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]      @relation("AuditUser")

  @@index([phone])
  @@index([email])
  @@map("users")
}

model WorkspaceUser {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  invitedBy     String?   @map("invited_by") @db.Uuid
  joinedAt      DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  permissions   Json      @default("{}") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@map("workspace_users")
}

model OtpCode {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  phone       String    @db.VarChar(20)
  code        String    @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  isUsed      Boolean   @default(false) @map("is_used")
  attempts    Int       @default(0)
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User?     @relation(fields: [userId], references: [id])

  @@index([phone, isUsed])
  @@index([expiresAt])
  @@map("otp_codes")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  token       String    @unique
  workspaceId String?   @map("workspace_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  isRevoked   Boolean   @default(false) @map("is_revoked")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model PushToken {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  token       String
  platform    String    @db.VarChar(10)
  appVariant  String    @map("app_variant") @db.VarChar(20)
  isActive    Boolean   @default(true) @map("is_active")
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz
  deviceId    String?   @map("device_id")
  appVersion  String?   @map("app_version") @db.VarChar(20)

  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, token, appVariant])
  @@index([userId, isActive])
  @@map("push_tokens")
}

// ─────────────────────────────────────────────────────────────
// PROPERTIES & UNITS
// ─────────────────────────────────────────────────────────────

model Property {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  ownerId         String?        @map("owner_id") @db.Uuid
  name            String         @db.VarChar(255)
  type            PropertyType
  status          PropertyStatus @default(ACTIVE)
  countryCode     CountryCode    @default(AE) @map("country_code")
  city            String         @db.VarChar(100)
  area            String         @db.VarChar(100)
  address         String
  latitude        Decimal?       @db.Decimal(10, 8)
  longitude       Decimal?       @db.Decimal(11, 8)
  titleDeedNo     String?        @map("title_deed_no") @db.VarChar(100)
  plotNo          String?        @map("plot_no") @db.VarChar(50)
  makaniNo        String?        @map("makani_no") @db.VarChar(20)
  dldPermitNo     String?        @map("dld_permit_no") @db.VarChar(100)
  reraPermitNo    String?        @map("rera_permit_no") @db.VarChar(100)
  yearBuilt       Int?           @map("year_built")
  totalUnits      Int            @default(1) @map("total_units")
  currencyCode    String         @default("AED") @map("currency_code") @db.Char(3)
  description     String?
  photos          Json           @default("[]") @db.JsonB
  floorPlanUrl    String?        @map("floor_plan_url")
  amenities       Json           @default("[]") @db.JsonB
  developerName   String?        @map("developer_name") @db.VarChar(255)
  buildingAge     Int?           @map("building_age")
  serviceCharge   Decimal?       @map("service_charge") @db.Decimal(10, 2)
  meta            Json           @default("{}") @db.JsonB
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz

  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  owner           Owner?         @relation(fields: [ownerId], references: [id])
  units           Unit[]
  listings        PropertyListing[]
  auditLogs       AuditLog[]
  reviews         Review[]

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, ownerId])
  @@map("properties")
}

model Unit {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId          String          @map("property_id") @db.Uuid
  workspaceId         String          @map("workspace_id") @db.Uuid
  unitNumber          String          @map("unit_number") @db.VarChar(50)
  floor               Int?
  type                UnitType        @default(ONE_BR)
  areaSqft            Decimal?        @map("area_sqft") @db.Decimal(10, 2)
  bedroomCount        Int?            @map("bedroom_count")
  bathroomCount       Int?            @map("bathroom_count")
  annualRent          Decimal?        @map("annual_rent") @db.Decimal(12, 2)
  occupancyStatus     OccupancyStatus @default(VACANT) @map("occupancy_status")
  furnishingStatus    FurnishingStatus @default(UNFURNISHED) @map("furnishing_status")
  securityDepositPct  Decimal         @default(5.00) @map("security_deposit_pct") @db.Decimal(4, 2)
  view                String?         @db.VarChar(100)
  parkingSlots        Int             @default(0) @map("parking_slots")
  photos              Json            @default("[]") @db.JsonB
  amenities           Json            @default("[]") @db.JsonB
  purchasePrice       Decimal?        @map("purchase_price") @db.Decimal(12, 2)
  purchaseDate        DateTime?       @map("purchase_date") @db.Date
  estimatedValue      Decimal?        @map("estimated_value") @db.Decimal(12, 2)
  lastValuedAt        DateTime?       @map("last_valued_at") @db.Timestamptz
  grossYieldPct       Decimal?        @map("gross_yield_pct") @db.Decimal(5, 2)
  notes               String?
  meta                Json            @default("{}") @db.JsonB
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz

  property            Property        @relation(fields: [propertyId], references: [id])
  workspace           Workspace       @relation(fields: [workspaceId], references: [id])
  leases              Lease[]
  tickets             Ticket[]
  receipts            Receipt[]

  @@unique([propertyId, unitNumber])
  @@index([workspaceId, occupancyStatus])
  @@index([propertyId])
  @@map("units")
}

// ─────────────────────────────────────────────────────────────
// OWNERS
// ─────────────────────────────────────────────────────────────

model Owner {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  userId              String?   @unique @map("user_id") @db.Uuid
  fullName            String    @map("full_name") @db.VarChar(255)
  displayName         String?   @map("display_name") @db.VarChar(100)
  phone               String    @db.VarChar(20)
  email               String?   @db.VarChar(255)
  nationality         String?   @db.VarChar(100)
  kycType             KycType   @default(EXPAT_RESIDENT) @map("kyc_type")
  passportNo          String?   @map("passport_no") @db.VarChar(50)
  emiratesId          String?   @map("emirates_id") @db.VarChar(20)
  emiratesIdExpiry    DateTime? @map("emirates_id_expiry") @db.Date
  residencyVisaNo     String?   @map("residency_visa_no") @db.VarChar(50)
  residencyVisaExpiry DateTime? @map("residency_visa_expiry") @db.Date
  passportExpiry      DateTime? @map("passport_expiry") @db.Date
  tradeLicenseNo      String?   @map("trade_license_no") @db.VarChar(50)
  companyName         String?   @map("company_name") @db.VarChar(255)
  bankIban            String?   @map("bank_iban") @db.VarChar(34)
  bankName            String?   @map("bank_name") @db.VarChar(100)
  bankSwift           String?   @map("bank_swift") @db.VarChar(11)
  pmaSignedDate       DateTime? @map("pma_signed_date") @db.Date
  pmaExpiryDate       DateTime? @map("pma_expiry_date") @db.Date
  mgmtFeePct          Decimal   @default(5.00) @map("mgmt_fee_pct") @db.Decimal(5, 2)
  kycVerified         Boolean   @default(false) @map("kyc_verified")
  pmaStatus           PmaStatus @default(ACTIVE) @map("pma_status")
  pmaRenewalAlertSentAt DateTime? @map("pma_renewal_alert_sent_at") @db.Timestamptz
  isActive            Boolean   @default(true) @map("is_active")
  notes               String?
  meta                Json      @default("{}") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  properties          Property[]
  ownerSoas           OwnerSoa[]
  notifications       Notification[]
  receipts            Receipt[]
  taxCertificates     TaxCertificate[]

  @@index([workspaceId])
  @@index([phone])
  @@map("owners")
}

// ─────────────────────────────────────────────────────────────
// TENANTS
// ─────────────────────────────────────────────────────────────

model Tenant {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  userId              String?   @unique @map("user_id") @db.Uuid
  fullName            String    @map("full_name") @db.VarChar(255)
  phone               String    @db.VarChar(20)
  email               String?   @db.VarChar(255)
  nationality         String?   @db.VarChar(100)
  kycType             KycType   @default(EXPAT_RESIDENT) @map("kyc_type")
  passportNo          String?   @map("passport_no") @db.VarChar(50)
  passportExpiry      DateTime? @map("passport_expiry") @db.Date
  emiratesId          String?   @map("emirates_id") @db.VarChar(20)
  emiratesIdExpiry    DateTime? @map("emirates_id_expiry") @db.Date
  residencyVisaNo     String?   @map("residency_visa_no") @db.VarChar(50)
  residencyVisaExpiry DateTime? @map("residency_visa_expiry") @db.Date
  tradeLicenseNo      String?   @map("trade_license_no") @db.VarChar(50)
  tradeLicenseExpiry  DateTime? @map("trade_license_expiry") @db.Date
  companyName         String?   @map("company_name") @db.VarChar(255)
  emergencyContact    Json      @default("{}") @map("emergency_contact") @db.JsonB
  kycVerified         Boolean        @default(false) @map("kyc_verified")
  kycVerifiedAt       DateTime?      @map("kyc_verified_at") @db.Timestamptz
  kycVerifiedBy       String?        @map("kyc_verified_by") @db.Uuid
  screeningStatus     ScreeningStatus @default(PENDING) @map("screening_status")
  screeningApprovedAt DateTime?      @map("screening_approved_at") @db.Timestamptz
  screeningApprovedBy String?        @map("screening_approved_by") @db.Uuid
  isActive            Boolean        @default(true) @map("is_active")
  notes               String?
  meta                Json           @default("{}") @db.JsonB
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  leases              Lease[]
  tickets             Ticket[]
  rentCollections     RentCollection[]
  aiCalls             AiCall[]
  notifications       Notification[]
  reviews             Review[]
  npsResponses        NpsResponse[]
  aecbReports         AecbReport[]
  whatsappMessages    WhatsAppMessage[]

  @@index([workspaceId])
  @@index([phone])
  @@index([workspaceId, kycVerified])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────
// LEASES
// ─────────────────────────────────────────────────────────────

model Lease {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workspaceId           String          @map("workspace_id") @db.Uuid
  unitId                String          @map("unit_id") @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  leaseType             LeaseType       @default(RESIDENTIAL) @map("lease_type")
  status                LeaseStatus     @default(DRAFT)
  startDate             DateTime        @map("start_date") @db.Date
  endDate               DateTime        @map("end_date") @db.Date
  annualRent            Decimal         @map("annual_rent") @db.Decimal(12, 2)
