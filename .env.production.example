# ─────────────────────────────────────────────────────────────
#  MANARA OS — PRODUCTION ENVIRONMENT EXAMPLE
#  Copy to .env, fill values, never commit to git.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=production
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=https://app.manaraos.ae,https://manaraos.ae

# Database
DATABASE_URL=postgresql://USER:PASS@HOST:5432/manara_os?schema=public
DIRECT_URL=postgresql://USER:PASS@HOST:5432/manara_os?schema=public

# Redis (for BullMQ + caching)
REDIS_URL=redis://default:PASS@HOST:6379

# JWT
JWT_SECRET=GENERATE_64_BYTE_RANDOM_STRING_FOR_PROD
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_BYTE_RANDOM_STRING

# Rate limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── PII encryption (REQUIRED for production) ─────────────────
PII_ENCRYPTION_KEY=GENERATE_32_CHAR_SECRET_VIA_KMS
PII_ENCRYPTION_SALT=GENERATE_16_CHAR_SALT

# ─── Twilio WhatsApp Business (leave blank for simulation mode) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+971XXXXXXXXX
TWILIO_SMS_FROM=+971XXXXXXXXX

# ─── OpenAI (leave blank for simulation mode) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Email (configure ONE: SendGrid OR Postmark OR SMTP) ────────
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@manaraos.ae

# ─── Payments (configure at least one for live transactions) ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SECRET_KEY=
NETWORK_INTERNATIONAL_API_KEY=

# ─── File storage (S3-compatible) ───────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=manara-prod
S3_PUBLIC_URL=https://cdn.manaraos.ae

# ─── Observability ──────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── UAE Government APIs (commercial agreements required) ───────
# Leave blank until agreements close — code falls back to simulation
EJARI_API_KEY=
RERA_API_KEY=
AECB_MEMBER_ID=
AECB_API_KEY=
TRAKHEESI_API_KEY=

# ─── Webhook secrets (rotate quarterly) ─────────────────────────
WEBHOOK_SIGNING_SECRET=GENERATE_SECRET_PER_INTEGRATION
