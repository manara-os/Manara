# ═══════════════════════════════════════════════════════════════
# MANARA OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill all values before deployment
# ═══════════════════════════════════════════════════════════════

# ── ENVIRONMENT ──────────────────────────────────────────────
NODE_ENV=development
APP_VERSION=3.0.0
LOG_LEVEL=info

# ── API ──────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,https://*.manaraos.ae

# ── WEB FRONTEND ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://manara:manara_pass@localhost:5432/manara_os
DATABASE_TEST_URL=postgresql://manara:manara_pass@localhost:5432/manara_os_test
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── REDIS ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=30d

# ── PLATFORM ADMIN ───────────────────────────────────────────
PLATFORM_ADMIN_SECRET=PLATFORM_LEVEL_JWT_BYPASS_SECRET_CHANGE_THIS

# ── OTP ──────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_DEV_BYPASS=123456
SMS_PROVIDER=twilio

# ── AWS ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
AWS_S3_BUCKET=manara-os-documents
AWS_CLOUDFRONT_DOMAIN=

# ── STRIPE ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_STARTER_PRICE_ID=price_
STRIPE_PRO_PRICE_ID=price_
STRIPE_ENTERPRISE_PRICE_ID=price_

# ── TWILIO ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+971XXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── OPENAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=alloy

# ── DLD / EJARI APIS ─────────────────────────────────────────
DLD_API_BASE_URL=https://api.dubailand.gov.ae
DLD_API_KEY=
DLD_CLIENT_ID=
DLD_CLIENT_SECRET=
EJARI_API_URL=https://ejari.dubailand.gov.ae/api
TRAKHEESI_API_URL=https://trakheesi.dubailand.gov.ae/api
RERA_INDEX_API_URL=https://smartrental.rera.gov.ae/api

# ── EMAIL ────────────────────────────────────────────────────
EMAIL_PROVIDER=ses
AWS_SES_REGION=me-central-1
EMAIL_FROM=noreply@manaraos.ae
EMAIL_FROM_NAME=Manara OS

# ── FIREBASE FCM ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── EXPO PUSH ────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── SENTRY ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── ENCRYPTION ───────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_THIS_32_BYTE_HEX_KEY_FOR_AES256
ENCRYPTION_IV=CHANGE_THIS_16_BYTE_HEX_IV_VALUE

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── GOOGLE MAPS ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── BULLMQ QUEUES ────────────────────────────────────────────
QUEUE_CONCURRENCY=5
QUEUE_MAX_JOBS=1000

# ── FEATURE FLAGS ────────────────────────────────────────────
FEATURE_AI_CALLS=true
FEATURE_EJARI_INTEGRATION=true
FEATURE_RERA_INDEX=true
FEATURE_INVESTMENT_INTELLIGENCE=true
FEATURE_PORTAL_SYNDICATION=false
