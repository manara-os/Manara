# Expo's own dependencies (expo-asset, expo-file-system, expo-keep-awake) declare
# `expo` back as a peer. npm's strict peer resolution walks into that cycle and
# silently skips them, and Metro then fails with "The required package
# expo-asset cannot be found". EAS Build installs with this file too, so the
# cloud build resolves the same tree as a local install.
legacy-peer-deps=true
